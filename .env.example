# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Instructions:
# 1. Copy this file and rename it to '.env'
# 2. Replace the values with your real credentials.
# IMPORTANT: The '.env' file is ignored in git, NEVER push it to the repository.

# --- Option A: University Proxy (SAIA) ---
API_BASE=https://your-university-endpoint-here.com/v1
API_KEY=your_personal_token_here
ROOT_AGENT_MODEL=meta-llama-3.1-8b-instruct

# --- Option B: Google AI Studio (free tier) ---
# Get a key at https://aistudio.google.com/apikey
API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
API_KEY=your_ai_studio_key_here
ROOT_AGENT_MODEL=gemini-2.5-flash

# --- Option B2: Real OpenAI (required for the OpenAI stack's web search) ---
# The OpenAI stack (agent.py) can use native web search via the Responses API
# (SubAgent(use_web_search=True)). That built-in tool ONLY works against the real
# OpenAI endpoint — NOT the AI Studio OpenAI-compatible base in Option B. To use
# OpenAI web search, point API_BASE at OpenAI and set a real OpenAI model.
# API_BASE=https://api.openai.com/v1
# API_KEY=your_real_openai_key_here
# ROOT_AGENT_MODEL=gpt-4o

# --- Option C: Native Google ADK (Gemini via AI Studio key) ---
# Used by the ADK agent graph (machine_learning_engineering/adk_agent.py).
# No Vertex/Cloud needed: the free AI Studio key works directly with native
# Gemini when GOOGLE_GENAI_USE_VERTEXAI=FALSE. (API_BASE/API_KEY above are only
# for the OpenAI-compatible ManagerAgent path, not for ADK.)
GOOGLE_API_KEY=your_ai_studio_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
ROOT_AGENT_MODEL=gemini-2.5-flash