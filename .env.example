# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Instructions:
# 1. Copy this file and rename it to '.env'
# 2. Fill in one (or both) provider blocks below.
# IMPORTANT: '.env' is gitignored — NEVER commit it.
#
# There is a SINGLE agent stack: the Google ADK graph in
# machine_learning_engineering/adk_agent.py. It drives native Gemini OR an
# OpenAI / OpenAI-compatible endpoint. Both credential sets can live here at
# once, prefixed GOOGLE_* / SCHOOL_*; pick one per run with PROVIDER=google
# (default) or PROVIDER=school (e.g. `make run-live PROVIDER=school ...`).
# See docs/agent-architecture.md and docs/USAGE.md.

# --- Provider "google": native Gemini (AI Studio free tier) — web search ON --
# Get a key at https://aistudio.google.com/apikey. A `gemini-*` model id routes
# to native Gemini; the free AI Studio key works without Vertex/Cloud.
GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_API_KEY=your_ai_studio_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_ROOT_AGENT_MODEL=gemini-2.5-flash

# --- Provider "school": OpenAI-compatible via ADK LiteLlm — web search OFF ---
# The model id MUST carry the litellm `openai/` prefix or it is misrouted to
# native Gemini. google_search is Gemini-only, so the analyst runs without web
# search on this path (the search prompt hints are stripped automatically).
SCHOOL_API_KEY=your_gwdg_or_proxy_key_here
SCHOOL_API_BASE=https://chat-ai.academiccloud.de/v1
SCHOOL_ROOT_AGENT_MODEL=openai/qwen3.5-397b-a17b

# Backward compatible: bare (unprefixed) ROOT_AGENT_MODEL / API_KEY / API_BASE
# still work — a missing prefixed var leaves the bare one untouched.
#   Real OpenAI:  API_BASE=https://api.openai.com/v1  ROOT_AGENT_MODEL=openai/gpt-4o

# Optional: output-token cap for the LiteLlm path (reasoning models think in
# output tokens; too low ends them mid-thought → fallback spec). Default 16384.
# LITELLM_MAX_TOKENS=16384
