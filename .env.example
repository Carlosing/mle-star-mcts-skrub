# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Instructions:
# 1. Copy this file and rename it to '.env'
# 2. Replace the values with your real credentials.
# IMPORTANT: The '.env' file is ignored in git, NEVER push it to the repository.

# --- Option A: University Proxy (SAIA) ---
# OPENAI_API_BASE=https://your-university-endpoint-here.com/v1
# OPENAI_API_KEY=your_personal_token_here
# ROOT_AGENT_MODEL=meta-llama-3.1-8b-instruct

# --- Option B: Google AI Studio (free tier, OpenAI-compatible endpoint) ---
# Get a key at https://aistudio.google.com/apikey
OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=your_ai_studio_key_here
ROOT_AGENT_MODEL=gemini-2.0-flash