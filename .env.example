# Copy this file as .env and fill in your real credentials.
# NEVER commit the .env file to git.

# University OpenAI-compatible proxy configuration (SAIA)
OPENAI_API_BASE=https://your-university-endpoint-here.com/v1
OPENAI_API_KEY=your_personal_token_here

# Default model for the agent
ROOT_AGENT_MODEL=meta-llama-3.1-8b-instruct

# Optional: enable DuckDuckGo web search during model retrieval
USE_WEB_SEARCH=false
WEB_SEARCH_NUM_RESULTS=5
